# Config for this copy of Vivek OS.
#
# DELIBERATELY EXCLUDED from the signed manifest: changing the port is a
# supported thing to do, and re-sealing for every deployment variation is not a
# workflow anyone would follow. Editing this file cannot make the app refuse to
# start, and it cannot make it start when something else has been changed.
#
# It cannot pin the network interface either. Nothing loads this file into
# process.env; it is read by ports.mjs and by the launcher, which parses the
# same keys by hand with the same rules. A COS_HOST line here would do nothing
# at all, which is why there is not one. Exactly two things decide the bind
# address: the real environment variable COS_HOST that the launcher sets to
# 127.0.0.1, and the code default compiled into the bundle, which this build
# also sets to 127.0.0.1 so that a launch which skips the launcher is loopback too.
#
# This copy keeps its chats and data in Documents\vivek-os (compiled in;
# COS_DATA_PARENT / COS_CHAT_PARENT here move them). The dev copy uses its own
# port and folder, so the two run side by side.

MDV2_PORT=4660

# Sir's CRM: the live site. The CRM view shows CRM_FE_URL; sign-in, the Claude
# subscription and usage go to CRM_BE_URL. Nothing of the CRM runs on this PC.
# For local dev servers instead (vba-fe / vba-be checkouts in the folder above
# this one, or SIRS_CRM_DIR=<folder>), set both to nothing: CRM_FE_URL= and
# CRM_BE_URL= -- the launcher then starts them on 4005 / 8008.
CRM_FE_URL=https://crm.vba.net.in
CRM_BE_URL=https://vbcrm.bhole.co
